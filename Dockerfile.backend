FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HOME=/home/resourceplanner

RUN groupadd --gid 10001 resourceplanner \
    && useradd --create-home --uid 10001 --gid resourceplanner resourceplanner

WORKDIR /app

COPY requirements-server.txt constraints-release.txt ./
RUN python -m pip install --no-cache-dir -r requirements-server.txt -c constraints-release.txt

COPY --chown=resourceplanner:resourceplanner app ./app
COPY --chown=resourceplanner:resourceplanner migrations ./migrations
COPY --chown=resourceplanner:resourceplanner alembic.ini ./

RUN mkdir -p /data /home/resourceplanner/.resourceplanner/logs \
    && chown -R resourceplanner:resourceplanner /data /home/resourceplanner/.resourceplanner

USER resourceplanner

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
    CMD python -c "from urllib.request import urlopen; r=urlopen('http://127.0.0.1:8000/health', timeout=3); raise SystemExit(0 if r.status == 200 else 1)"

CMD ["python", "-m", "app.server"]
