FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HOME=/home/resourceplanner

RUN groupadd --gid 10001 resourceplanner \
    && useradd --create-home --uid 10001 --gid resourceplanner resourceplanner

WORKDIR /app

COPY requirements-importer.txt constraints-release.txt ./
RUN python -m pip install --no-cache-dir -r requirements-importer.txt -c constraints-release.txt

COPY --chown=resourceplanner:resourceplanner app ./app
COPY --chown=resourceplanner:resourceplanner tools/import_erp_projects.py ./tools/import_erp_projects.py
COPY --chown=resourceplanner:resourceplanner tools/import_erp_tasks.py ./tools/import_erp_tasks.py\nCOPY --chown=resourceplanner:resourceplanner tools/import_resources.py ./tools/import_resources.py

RUN mkdir -p /data /imports \
    && chown -R resourceplanner:resourceplanner /data /imports /home/resourceplanner

USER resourceplanner

ENTRYPOINT ["python", "tools/import_erp_projects.py"]
CMD ["--help"]
